# FastAPI scaffold settings (the storefront runner uses backend/run_server.py).
PROJECT_NAME="ShopCart Online Shopping System"
VERSION="1.0.0"
API_V1_STR="/api"
DEBUG=true
HOST="127.0.0.1"
PORT=8000

# For local FastAPI development, use SQLite:
DATABASE_URL="sqlite:///./cartcraft.db"
# Set a private random key before enabling authentication routes:
SECRET_KEY="replace-with-a-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
